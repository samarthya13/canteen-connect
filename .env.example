# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# FIREBASE CONFIGURATION (Canteen Connect Project)
# Obtain these values from Firebase Console -> Project Settings -> General -> Your Apps (Web App)
# ==============================================================================
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
VITE_FIREBASE_APP_ID="your-firebase-app-id"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"

# ==============================================================================
# CANTEEN ADMINISTRATOR AUTHORIZATION (UID ENFORCEMENT)
# ==============================================================================
# The exact Firebase Authentication UID of your designated administrator account.
# Find this in Firebase Console -> Authentication -> Users -> User UID column.
VITE_FIREBASE_ADMIN_UID="your-admin-user-uid"

# Optional: Comma-separated list if multiple staff members need administrator access
# VITE_FIREBASE_ADMIN_UIDS="uid1,uid2"

# Optional: Registered administrator email for fallback matching
# VITE_FIREBASE_ADMIN_EMAIL="admin@yourcanteen.com"

